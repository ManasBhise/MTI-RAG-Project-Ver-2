{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/:match*",
      "destination": "https://mti-rag-project-ver-2-production.up.railway.app/auth/:match*"
    },
    {
      "source": "/chat/:match*",
      "destination": "https://mti-rag-project-ver-2-production.up.railway.app/chat/:match*"
    },
    {
      "source": "/chat",
      "destination": "https://mti-rag-project-ver-2-production.up.railway.app/chat"
    },
    {
      "source": "/documents/:match*",
      "destination": "https://mti-rag-project-ver-2-production.up.railway.app/documents/:match*"
    },
    {
      "source": "/user/:match*",
      "destination": "https://mti-rag-project-ver-2-production.up.railway.app/user/:match*"
    },
    {
      "source": "/static/:match*",
      "destination": "https://mti-rag-project-ver-2-production.up.railway.app/static/:match*"
    },
    {
      "source": "/health",
      "destination": "https://mti-rag-project-ver-2-production.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
