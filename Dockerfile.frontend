# ==============================================================================
# MTI Knowledge Assistant - Frontend Dockerfile (Vite React + Nginx)
# ==============================================================================

# Stage 1: Build the React 19 Frontend
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package manifests and install dependencies
COPY ["frontend/MTI_RAG_Project_Version 2/package.json", "frontend/MTI_RAG_Project_Version 2/package-lock.json*", "./"]

RUN npm install

# Copy frontend source files
COPY ["frontend/MTI_RAG_Project_Version 2/", "./"]

# Build production SPA bundle
RUN npm run build

# Stage 2: Production Nginx Server
FROM nginx:1.27-alpine

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built static bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Expose HTTP port
EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ || exit 1

# Run Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
