# JWT
JWT_SECRET_KEY=change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite for local dev; use PostgreSQL URL in production)
DATABASE_URL=sqlite:///./mti_assistant.db

# Frontend CORS
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# RAG pipeline
RAG_PIPELINE_MODULE=rag.pipeline
RAG_PIPELINE_FUNCTION=ask_question
RAG_DATA_DIR=
RAG_VECTOR_STORE_DIR=
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5

# Groq LLM (required for chat answers)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
